{
  "name": "@josh803316/kube-env-config",
  "version": "1.0.0",
  "description": "Config-driven Kubernetes environment management CLI",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "kec": "./dist/cli.js"
  },
  "files": [
    "dist/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/josh803316/kube-env-config.git"
  },
  "scripts": {
    "build": "bun build ./src/cli/index.ts --target node --outfile ./dist/cli.js",
    "dev": "bun run ./src/cli/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@kubernetes/client-node": "^1.4.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.2",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
